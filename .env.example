# ---- Required in production ----
# Any long random string (used to sign login cookies)
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the site (used inside SMS links)
APP_URL=http://localhost:3000

# ---- Database ----
# Local dev: leave blank -> uses data/local.db (a file on your computer)
# Production (free): create a Turso database at https://turso.tech and paste here
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- SMS ----
# log      = no real SMS, messages are saved to the "SMS outbox" page (free, default)
# textbee  = sends real SMS from YOUR Android phone via textbee.dev (free, uses your SIM's SMS pack)
# fast2sms = Indian SMS gateway (paid per SMS)
# twilio   = Twilio (trial credit, can only text verified numbers)
SMS_PROVIDER=log
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
